# CoreELEC Amlogic-ng 32-bit hard-float userland. Override CE_TOOLCHAIN for another build tree.
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR arm)
if(NOT CE_TOOLCHAIN)
  set(CE_TOOLCHAIN /home/user/p3i/build.CoreELEC-Amlogic-ng.arm-21/toolchain)
endif()
set(CMAKE_SYSROOT ${CE_TOOLCHAIN}/armv8a-libreelec-linux-gnueabihf/sysroot)
set(CMAKE_CXX_COMPILER ${CE_TOOLCHAIN}/bin/armv8a-libreelec-linux-gnueabihf-g++-13.3.0)
set(CMAKE_FIND_ROOT_PATH ${CMAKE_SYSROOT})
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_CXX_FLAGS_INIT "-march=armv7-a -mfpu=neon -mfloat-abi=hard")
