<?xml version="1.0" encoding="UTF-8"?>
<addon id="visualization.starlight" name="Starlight" version="1.0.0" provider-name="primez-x">
  <requires>
    <import addon="kodi.binary.global.main" version="2.0.2"/>
    <import addon="kodi.binary.instance.visualization" version="4.0.0"/>
  </requires>
  <extension point="xbmc.player.musicviz" library_linux="visualization.starlight.so"/>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Gold-to-frost radial spectrum for Starlight</summary>
    <description lang="en_GB">Audio-reactive radial bars and a soft glow surround the Starlight album cover. The skin supplies the cover and the paused dotted ring.</description>
    <platform>linux</platform>
    <assets><icon>resources/icon.png</icon></assets>
    <news>1.0.0
Initial GLES radial spectrum for Kodi 21 and the Starlight music stage.</news>
  </extension>
</addon>
